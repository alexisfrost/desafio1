PORT=3000
# Secret used to sign and verify JWTs (HS256). Use a long random string.
JWT_SECRET=change-me
# Token lifetime: seconds (3600) or a timespan string ("15m", "1h", "7d").
JWT_EXPIRES_IN=1h
# Any localhost origin (any port) is always allowed for CORS.
# Optional comma-separated list of extra allowed origins.
CORS_ORIGINS=
